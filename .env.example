# Copy to .env and fill in. These are server-only (no VITE_ prefix), so they are
# never shipped to the browser. On Vercel, add the same names under
# Project Settings > Environment Variables.

# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: any current Groq chat model. Defaults to openai/gpt-oss-120b.
# Faster/cheaper alternative: openai/gpt-oss-20b
GROQ_MODEL=

# --- Contact form (Resend) ---
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional: inbox that receives messages. Defaults to the email in portfolioData.js.
# Without a verified domain, Resend only delivers to the email you signed up with.
CONTACT_TO_EMAIL=

# Optional: sender. Leave empty to use Resend's test sender (onboarding@resend.dev).
CONTACT_FROM_EMAIL=
